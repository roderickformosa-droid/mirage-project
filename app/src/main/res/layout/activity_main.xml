<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">

    <!-- v0.6 FIELD VIEW: camera owns roughly 90% of the display. -->
    <androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/controlStrip" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.mirage.app.ui.RoiOverlayView android:id="@+id/roiOverlay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="@id/previewView" app:layout_constraintBottom_toBottomOf="@id/previewView" app:layout_constraintStart_toStartOf="@id/previewView" app:layout_constraintEnd_toEndOf="@id/previewView" />
    <com.mirage.app.ui.WindCueOverlayView android:id="@+id/windCueOverlay" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="@id/previewView" app:layout_constraintBottom_toBottomOf="@id/previewView" app:layout_constraintStart_toStartOf="@id/previewView" app:layout_constraintEnd_toEndOf="@id/previewView" />
    <com.mirage.app.ui.DebugOverlayView android:id="@+id/debugOverlay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="@id/previewView" app:layout_constraintBottom_toBottomOf="@id/previewView" app:layout_constraintStart_toStartOf="@id/previewView" app:layout_constraintEnd_toEndOf="@id/previewView" />

    <TextView android:id="@+id/signalQualityText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="7dp" android:background="#8A000000" android:padding="6dp" android:text="SEARCHING" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/targetHudText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="7dp" android:background="#8A000000" android:padding="6dp" android:fontFamily="monospace" android:gravity="end" android:text="AZ --  --\nANGLE --\nRANGE --" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/readoutText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

    <Button android:id="@+id/resumeButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESUME" android:textStyle="bold" android:visibility="gone" android:enabled="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/previewView" app:layout_constraintBottom_toBottomOf="@id/previewView" />

    <HorizontalScrollView android:id="@+id/controlStrip" android:layout_width="0dp" android:layout_height="wrap_content" android:fillViewport="true" android:background="#F0141414" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="3dp">
            <ToggleButton android:id="@+id/focusLockToggle" android:layout_width="wrap_content" android:layout_height="42dp" android:textOn="FOCUS LOCK" android:textOff="FOCUS AUTO" android:textSize="8sp" />
            <ToggleButton android:id="@+id/exposureLockToggle" android:layout_width="wrap_content" android:layout_height="42dp" android:textOn="EXP LOCK" android:textOff="EXP AUTO" android:textSize="8sp" />
            <Button android:id="@+id/locationButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="GPS" android:textSize="8sp" />
            <TextView android:id="@+id/temperatureText" android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center" android:paddingHorizontal="8dp" android:text="TEMP --" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            <ToggleButton android:id="@+id/autoBrightnessToggle" android:layout_width="wrap_content" android:layout_height="42dp" android:textOn="BRIGHT AUTO" android:textOff="BRIGHT MAN" android:textSize="8sp" />
            <SeekBar android:id="@+id/brightnessSeek" android:layout_width="110dp" android:layout_height="42dp" android:max="100" android:progress="70" />
            <TextView android:id="@+id/brightnessPercent" android:layout_width="58dp" android:layout_height="42dp" android:gravity="center" android:text="70%" android:textColor="#FFFFFF" android:textSize="8sp" />
            <Button android:id="@+id/zoomMinus" android:layout_width="44dp" android:layout_height="42dp" android:text="−" />
            <TextView android:id="@+id/zoomText" android:layout_width="62dp" android:layout_height="42dp" android:gravity="center" android:text="1.0x" android:textColor="#FFFFFF" android:textSize="8sp" />
            <Button android:id="@+id/zoomPlus" android:layout_width="44dp" android:layout_height="42dp" android:text="+" />
            <Button android:id="@+id/recordButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="RECORD" android:textSize="8sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Engineering controls remain in the build but are hidden from the field-test UI. -->
    <LinearLayout android:id="@+id/hiddenEngineering" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:orientation="vertical">
        <ToggleButton android:id="@+id/debugToggle" android:layout_width="1dp" android:layout_height="1dp" />
        <ToggleButton android:id="@+id/autoRoiToggle" android:layout_width="1dp" android:layout_height="1dp" />
        <ToggleButton android:id="@+id/autoZoomToggle" android:layout_width="1dp" android:layout_height="1dp" />
        <ToggleButton android:id="@+id/autoRangeToggle" android:layout_width="1dp" android:layout_height="1dp" />
        <EditText android:id="@+id/knownRangeInput" android:layout_width="1dp" android:layout_height="1dp" />
        <EditText android:id="@+id/scopeFovInput" android:layout_width="1dp" android:layout_height="1dp" android:text="2.0" />
        <ToggleButton android:id="@+id/seaLevelToggle" android:layout_width="1dp" android:layout_height="1dp" />
        <ToggleButton android:id="@+id/targetHudToggle" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/navRangeText" android:layout_width="1dp" android:layout_height="1dp" />
        <com.mirage.app.ui.GraphView android:id="@+id/graphActivity" android:layout_width="1dp" android:layout_height="1dp" />
        <com.mirage.app.ui.GraphView android:id="@+id/graphAngle" android:layout_width="1dp" android:layout_height="1dp" />
        <com.mirage.app.ui.GraphView android:id="@+id/graphMagnitude" android:layout_width="1dp" android:layout_height="1dp" />
        <com.mirage.app.ui.GraphView android:id="@+id/graphStabResidual" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
